<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="690.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="control.PrincipalController">
   <children>
      <Pane layoutX="14.0" layoutY="14.0" prefHeight="376.0" prefWidth="300.0" style="-fx-border-color: #000000; -fx-background-color: #FFFFFF;">
         <children>
            <Button fx:id="btn_goClientes" layoutX="80.0" layoutY="119.0" mnemonicParsing="false" onAction="#doGoClientes" onMouseEntered="#showClientes" onMouseExited="#showStartup" prefHeight="25.0" prefWidth="145.0" text="Gestión Clientes" textFill="#0800fc">
               <font>
                  <Font name="Microsoft Sans Serif" size="12.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btn_goProductos" layoutX="80.0" layoutY="176.0" mnemonicParsing="false" onAction="#doGoProductos" onMouseEntered="#showProductos" onMouseExited="#showStartup" prefHeight="25.0" prefWidth="145.0" text="Gestión Productos" textFill="#0800fc">
               <font>
                  <Font name="Microsoft Sans Serif" size="12.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btn_goTransacciones" layoutX="80.0" layoutY="237.0" mnemonicParsing="false" onAction="#doGoTransacciones" onMouseEntered="#showTransacciones" onMouseExited="#showStartup" prefHeight="25.0" prefWidth="145.0" text="Transacciones" textFill="#0800fc">
               <font>
                  <Font name="Microsoft Sans Serif" size="12.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="btn_salir" alignment="CENTER" layoutX="21.0" layoutY="337.0" mnemonicParsing="false" onAction="#doSalir" prefHeight="25.0" prefWidth="84.0" text="Salir" textFill="#ef0000">
               <font>
                  <Font name="Microsoft Sans Serif" size="12.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <ImageView fx:id="img_logo" fitHeight="83.0" fitWidth="259.0" layoutX="22.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </Pane>
      <Pane layoutX="314.0" layoutY="14.0" prefHeight="376.0" prefWidth="366.0" style="-fx-border-color: #000000;">
         <children>
            <ImageView fx:id="img_display" fitHeight="376.0" fitWidth="366.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </Pane>
   </children>
</AnchorPane>
